{
  "name": "agents-vs-wall-street-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "forecast": ".venv/bin/python -m forecast.ml_hd --as-of 2026-08-16 && .venv/bin/python -m forecast.ml_hd_v2 --as-of 2026-08-16 && .venv/bin/python -m forecasting.backtest --as-of 2026-08-16 --street-only && .venv/bin/python -m forecast.run --as-of 2026-08-16 && .venv/bin/python -m forecast.historical_backtest --as-of 2026-08-16",
    "backtest:five-year": ".venv/bin/python -m forecast.historical_backtest --as-of 2026-08-16 --quarters 20",
    "test:forecast": ".venv/bin/python -m pytest -q tests forecasting/test_backtest.py",
    "setup:entry": "node scripts/setup-entry.mjs",
    "check:entry": "node scripts/check-entry.mjs",
    "check:forecasts": "node scripts/check-forecasts.mjs submission",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:submission": "npm run check:entry && npm run check:forecasts && npm run check:architecture",
    "test:starter": "python3 -m unittest discover -s starter -p 'test_*.py'"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
